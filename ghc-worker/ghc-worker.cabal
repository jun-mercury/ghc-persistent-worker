cabal-version: 2.2
name: ghc-worker
version: 0.1
synopsis: GHC persistent worker through gRPC connection
license: MIT
license-file: LICENSE
build-type: Simple

flag debug
    description: Compiled with debug mode. Dump all on failure
    manual: True
    default: False

flag mwb
    description: Use mwb-customized GHC from January 2026
    manual: True
    default: False

flag ghc-debug
  description: Build with support for ghc-debug
  manual: True
  default: False

common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DuplicateRecordFields,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StrictData,
    TypeFamilies
  build-depends:
    base ==4.*

  if (flag(mwb))
      cpp-options: -DMWB -DDOWNSWEEP_CACHE -DUNIT_INDEX

library
  import: all
  ghc-options: -O2
  hs-source-dirs: lib
  exposed-modules:
    GhcWorker.BuildKey
    GhcWorker.Caps
    GhcWorker.CompileResult
    GhcWorker.CwdHandoff
    GhcWorker.GhcHandler
    GhcWorker.Grpc
    GhcWorker.Instrumentation
    GhcWorker.Orchestration
    GhcWorker.RequestCwd
    GhcWorker.Run
  build-depends:
    async,
    binary,
    buck-worker-grpc,
    buck-worker-internal,
    buck-worker-proto,
    buck-worker-types,
    bytestring,
    containers,
    deepseq,
    directory,
    file-io,
    ghc,
    grapesy >=1.0.1,
    network,
    optparse-applicative,
    os-string,
    process,
    stm,
    text,
    unix
  if (flag(ghc-debug))
    build-depends:
       ghc-debug-stub
    ghc-options: -DGHC_DEBUG

  if (flag(debug))
      cpp-options: -D__DEBUG__

executable ghc-worker
  import: all
  main-is: Main.hs
  hs-source-dirs: app/ghc-worker
  if os(linux) && arch(x86_64)
      ghc-options: -O2 -threaded -rtsopts "-with-rtsopts=-K512M -I5 -A128M -T -N -xm40000000 -xp"
  else
      ghc-options: -O2 -threaded -rtsopts "-with-rtsopts=-K512M -I5 -A128M -T -N"
  build-depends:
    ghc-worker

-- The external interpreter for forked evals (P1b-5, an experiment): GHC's iserv with an armed EvalStmt run in a
-- forked child. Dynamic, because the session's interpreter is, and without -threaded, so that forking it is the plain
-- Unix fork (a threaded process's child loses its IO manager). Named with GHC's "-dyn" suffix: a dynamic session runs
-- pgm_i ++ "-dyn". Outside "common all", whose extensions are the worker's, not iserv's. -fkeep-cafs, as GHC's own
-- iserv sets keep_cafs in its C main: loaded objects and bytecode refer to CAFs the GC cannot see, and without it a GC
-- frees them under the loaded image (P1b-5 runs 2-4: evacuate barfs while loading the core image).
executable ghc-worker-iserv-dyn
  main-is: Main.hs
  hs-source-dirs: app/ghc-worker-iserv
  other-modules: IservTrace
  default-language: GHC2021
  ghc-options: -O1 -dynamic -rtsopts -fkeep-cafs
  build-depends:
    base ==4.*,
    binary,
    directory,
    ghci,
    unix

-- The command a remote-execution action runs in place of ghc: argv and
-- environment go to the server named by GHC_PERSISTENT_WORKER_SOCKET as one
-- request, the response's exit code comes back. Kept off the ghc-worker
-- library so it does not link the ghc library.
executable ghc-worker-client
  import: all
  main-is: Main.hs
  hs-source-dirs: app/ghc-worker-client client
  other-modules: GhcWorkerClient.Sockets
  ghc-options: -O2 -threaded
  build-depends:
    buck-worker-proto,
    bytestring,
    directory,
    filepath,
    grapesy >=1.0.1,
    network,
    text,
    unix

test-suite ghc-worker-test
  import: all
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test client app/ghc-worker-iserv
  other-modules:
    GhcWorkerClient.Sockets,
    IservTrace,
    IservTraceTest,
    BuildPlanTest.Test1,
    BuildPlanTest.Test2,
    BuildKeyTest,
    CapsTest,
    ConcurrentTest,
    DepFilesTest,
    EvalTest,
    ExtraLibTest,
    FlagParserTest,
    HandoffTest,
    SocketsTest,
    InterfacePathTest,
    ProjectBuildTest,
    Resource.Measure,
    Resource.BasicTest,
    ScheduleTest,
    StaleUnitTest
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N -T"
  build-depends:
    aeson,
    buck-worker-grpc,
    buck-worker-internal,
    buck-worker-types,
    bytestring,
    containers,
    directory,
    exceptions,
    extra,
    filepath,
    ghc,
    ghc-boot,
    ghc-paths,
    ghc-worker,
    ghc-worker-test-common,
    ghci,
    hedgehog >= 1.5,
    stm,
    tasty >= 1.5.4,
    tasty-hedgehog,
    network,
    unix,
    text